#!/bin/sh
# Start nm-applet as a status-notifier item only once the panel's tray is listening.
# Started earlier, it falls back to an old-style tray icon in the icon theme's blue and can show up twice.
for i in $(seq 30); do
    busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 && break
    sleep 1
done
exec nm-applet --indicator
